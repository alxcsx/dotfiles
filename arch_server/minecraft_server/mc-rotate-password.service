[Unit]
Description=Rotate the Minecraft shared join password and announce it
Documentation=https://github.com/alxcsx/dotfiles/tree/main/arch_server/minecraft_server
# The rotation goes over RCON, so the container must be up. After= is enough:
# if Minecraft is down the script exits 1 with a clear message rather than
# starting the server on its own.
After=minecraft.service

[Service]
Type=oneshot
# systemd user services get PATH=/usr/local/bin:/usr/bin by default, which would
# not find `mc-password` or `hermes` in ~/.local/bin and the run would fail at the
# readback step. Set it explicitly.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/.local/bin/mc-rotate-password.sh
TimeoutStartSec=120
