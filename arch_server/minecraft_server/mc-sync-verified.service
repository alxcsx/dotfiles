[Unit]
Description=Grant the weekly-password bypass to Minecraft players with an account
Documentation=https://github.com/alxcsx/dotfiles/tree/main/arch_server/minecraft_server
After=minecraft.service

[Service]
Type=oneshot
# Needs podman + python3 only; no ~/.local/bin helpers are called, so the default
# PATH is fine.
ExecStart=/usr/bin/python3 %h/.local/bin/mc-sync-verified
TimeoutStartSec=120
