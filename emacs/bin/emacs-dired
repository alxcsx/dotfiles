#!/usr/bin/env bash
# ~/.local/bin/emacs-dired

TARGET="${1:-$HOME}"

# Under Wayland with PGTK Emacs, inheriting DISPLAY=:0 from Xwayland apps
# causes PGTK Emacs to attempt an X11 connection and crash. Prioritize Wayland.
if [ -n "$WAYLAND_DISPLAY" ]; then
    unset DISPLAY
fi

# Clean file:// URI prefix if present
if [[ "$TARGET" =~ ^file://(.*)$ ]]; then
    TARGET="${BASH_REMATCH[1]}"
fi

exec emacsclient -r -n -a "" --eval "(progn (require 'url-util) (dired (url-unhex-string \"$TARGET\")))"
