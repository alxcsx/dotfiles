#!/usr/bin/env bash
# ~/.local/bin/emacs-dired

# Ensure a valid terminal type is exported so emacsclient does not error on headless/dumb invocations
if [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    export TERM="xterm-256color"
fi

# Under Wayland with PGTK Emacs, force Wayland backend without breaking emacsclient
if [ -n "$WAYLAND_DISPLAY" ]; then
    export GDK_BACKEND=wayland
    export DISPLAY="${DISPLAY:-$WAYLAND_DISPLAY}"
fi

# Visiting a directory opens dired; the .desktop passes a decoded local path (%f)
exec emacsclient -r -n -a "" "${1:-$HOME}"
