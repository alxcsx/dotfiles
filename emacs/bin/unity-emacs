#!/usr/bin/env bash
# ~/.local/bin/unity-emacs

FILE="$1"
LINE="$2"
COL="$3"

# Ensure a valid terminal type is exported so emacsclient does not error on headless/dumb invocations
if [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    export TERM="xterm-256color"
fi

# Force GTK to prioritize Wayland without breaking emacsclient's display check
if [ -n "$WAYLAND_DISPLAY" ]; then
    export GDK_BACKEND=wayland
    export DISPLAY="${DISPLAY:-$WAYLAND_DISPLAY}"
fi

# Ensure developer environment (mise, dotnet, rust) is present if emacs daemon needs to start
if command -v mise >/dev/null 2>&1; then
    eval "$(mise env --shell bash 2>/dev/null)"
fi

# Clean file:// URI prefix if present
if [[ "$FILE" =~ ^file://(.*)$ ]]; then
    FILE="${BASH_REMATCH[1]}"
fi

# Open file with line/col if provided (a directory opens in dired)
ARGS=()
if [ -n "$LINE" ] && [ "$LINE" -gt 0 ] 2>/dev/null; then
    if [ -n "$COL" ] && [ "$COL" -gt 0 ] 2>/dev/null; then
        ARGS+=("+${LINE}:${COL}")
    else
        ARGS+=("+${LINE}")
    fi
fi

if [ -n "$FILE" ]; then
    ARGS+=("$FILE")
fi

exec emacsclient -r -n -a "" "${ARGS[@]}"

