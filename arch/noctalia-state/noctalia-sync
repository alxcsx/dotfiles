#!/usr/bin/env python3
"""Keep ~/.local/state/noctalia/settings.toml in the dotfiles repo without
leaking personal or machine-specific settings into the shared config.

    pull   live settings -> base (shared) + hosts/<hostname> override
    push   base + host override -> live settings

install.sh runs `push`; a systemd path unit runs `pull` whenever noctalia
saves, so UI changes land in the repo by themselves.
"""

import shutil
import socket
import sys
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent  # arch/
BASE = REPO / "noctalia-state" / "settings.toml"
HOST_OVERRIDE = REPO / "hosts" / socket.gethostname() / "noctalia-state" / "settings.toml"
LIVE = Path.home() / ".local/state/noctalia/settings.toml"

# ponytail: top-level TOML sections that never go into the shared base. These
# are either personal (calendar accounts) or bound to hardware that differs
# per machine (per-output widgets, wallpaper paths). Add section names here
# when noctalia grows more of either.
OVERRIDE_SECTIONS = {"wallpaper", "calendar", "desktop_widgets", "lockscreen_widgets"}

HEADER = "# Generated by noctalia-sync pull — edit via the noctalia UI and pull,\n" \
         "# or push to apply base + host override to the live file.\n"


def chunks(text):
    """Split TOML text into chunks: a top-level table header (column 0) and
    everything under it. Nested tables are indented and stay in their chunk."""
    out, cur = [], []
    for line in text.splitlines(keepends=True):
        if line.startswith("[") and cur:
            out.append("".join(cur))
            cur = []
        cur.append(line)
    if cur:
        out.append("".join(cur))
    return out


def section_name(chunk):
    for line in chunk.splitlines():
        if line.lstrip().startswith("["):
            return line.strip().strip("[]").split(".")[0]
    return ""  # bare keys before the first header (e.g. config_version)


def is_override(chunk):
    return section_name(chunk) in OVERRIDE_SECTIONS


def validate(text, label):
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        sys.exit(f"noctalia-sync: invalid TOML in {label}: {e}")


def pull():
    live_text = LIVE.read_text()
    parts = chunks(live_text)
    base = "".join(c for c in parts if not is_override(c))
    override = "".join(c for c in parts if is_override(c))
    merged = base + "\n" + override
    validate(merged, "split result")
    # ponytail: guard against the classifier leaking personal/hardware sections
    leaked = [s for s in OVERRIDE_SECTIONS if f"[{s}" in base]
    if leaked:
        sys.exit(f"noctalia-sync: {', '.join(leaked)} leaked into the base")
    if tomllib.loads(merged) != tomllib.loads(live_text):
        sys.exit("noctalia-sync: split changed the settings")
    BASE.write_text(HEADER + base)
    HOST_OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
    HOST_OVERRIDE.write_text(HEADER + override)
    print(f"noctalia-sync: pulled {LIVE}\n  -> {BASE}\n  -> {HOST_OVERRIDE}")


def push():
    text = BASE.read_text()
    if HOST_OVERRIDE.exists():
        text += "\n" + HOST_OVERRIDE.read_text()
    validate(text, "merged settings")
    if LIVE.exists():
        shutil.copy2(LIVE, LIVE.with_name(LIVE.name + ".bak"))
    if LIVE.is_symlink():
        LIVE.unlink()  # never write through a link into the repo
    LIVE.parent.mkdir(parents=True, exist_ok=True)
    LIVE.write_text(text)
    print(f"noctalia-sync: pushed -> {LIVE}")


if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in ("pull", "push"):
        sys.exit(__doc__)
    {"pull": pull, "push": push}[sys.argv[1]]()
