# Example llama.cpp model preset — for the real one:
#   cp ~/.config/llamacpp/models-preset.ini.example ~/.config/llamacpp/models-preset.ini
# then edit the paths (the real preset is machine-local and never committed).
# NOTE: llama-server does NOT expand `~` — use absolute paths.

version = 1

[*]
ngl = auto
ctx-size = 8192
stop-timeout = 30

[phi35]
model = /home/YOU/.config/llamacpp/models/Phi-3.5-mini-instruct-Q4_K_M.gguf
ctx-size = 8192

[qwen3.5:9B]
model = /home/YOU/.config/llamacpp/models/Qwen3.5-9B-UD-Q6_K_XL.gguf
ctx-size = 65536
