#!/usr/bin/env bash
# Start every installed agent (omp, agy, claude, copilot, codex) in a Herdr core
# workspace for the current folder, then attach to omp.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd)
# shellcheck source=_agents.sh
. "$SCRIPT_DIR/_agents.sh"

if ! command -v hc >/dev/null 2>&1; then
  printf 'hc not found. Install it with: ./dot.sh install ai\n' >&2
  exit 1
fi

pane_running() {
  if command -v jq >/dev/null 2>&1; then
    hc ls --json 2>/dev/null | jq -e --arg n "$1" 'any(.[]; .name == $n)' >/dev/null 2>&1
  else
    hc ls --json 2>/dev/null | grep -q "\"name\":\"$1\""
  fi
}

start_pane() {
  local name="$1" agent="$2" model="$3"
  pane_running "$name" && return 0
  local argv=("$(command -v "$agent")")
  append_model_args "$agent" "$model" ""
  append_permission_args "$agent" interactive ""
  # Outlive this launcher so closing the terminal does not kill the agents.
  hc run --bg --outlive-parent --name "$name" --cwd "$PWD" \
    env "${clean_env_args[@]}" "${argv[@]}" >/dev/null
}

# hc keeps terminals in the background. The app only shows terminals that
# have a pane, so give each one a tab (idempotent when it already has one).
show_in_app() {
  local name="$1" id
  id=$(hc_get_field "$name" address)
  if [ -n "$id" ]; then
    herdr-app do terminal.keep --terminal "$id" --place tab >/dev/null || true
  fi
}

# Starting agy through orch expresses trust in the current workspace. Confirm
# only its folder trust dialog; leave all other permission prompts untouched.
confirm_agy_workspace() {
  local name="$1" screen _
  for _ in {1..50}; do
    screen=$(hc read "$name" 2>/dev/null || true)
    if [[ "$screen" == *"Do you trust the contents of this project?"* &&
          "$screen" == *"> Yes, I trust this folder"* ]]; then
      hc send --force "$name" "" >/dev/null
      return
    fi
    sleep 0.2
  done
}

gui=0
inside_herdr=0
[ -n "${HC_TERMINAL_ID:-}" ] && inside_herdr=1
if [ "$inside_herdr" = 1 ] && command -v herdr-app >/dev/null 2>&1; then
  # We already have an app window. Add panes to it below; do not launch another.
  gui=1
elif command -v herdr-app >/dev/null 2>&1 &&
  [ -z "${SSH_TTY:-}${SSH_CONNECTION:-}" ] &&
  { [ "$(uname -s)" = "Darwin" ] || [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; }; then
  gui=1
  herdr-app >/dev/null 2>&1 &
  # Let the window connect to herdr-core before adding tabs.
  for _ in {1..50}; do
    herdr-app status >/dev/null 2>&1 && break
    sleep 0.2
  done
fi

# Usage: orch [agent[:model] ...]   (default: omp agy claude copilot codex)
#   orch omp:deepseek-v4.1-flash omp:deepseek-v4-pro agy:hydrogen agy:argon
# The same agent may appear with several models; each gets its own pane.
# Panes are named per workspace (omp-dotfiles, ...) so each folder gets its
# own set. `ask` resolves names the same way.
ws=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" | tr -c 'A-Za-z0-9_\n-' '-')

build_clean_env

started=()
[ $# -gt 0 ] || set -- omp agy claude copilot codex
for spec in "$@"; do
  agent="${spec%%:*}" model=""
  [ "$spec" = "$agent" ] || model="${spec#*:}"
  command -v "$agent" >/dev/null 2>&1 || continue
  name=$(pane_name "$agent" "$model" "" "$ws")
  start_pane "$name" "$agent" "$model"
  if [ "$agent" = agy ]; then
    confirm_agy_workspace "$name" >/dev/null 2>&1 &
  fi
  started+=("$name")
done
if [ ${#started[@]} -eq 0 ]; then
  printf 'No agents found in PATH. Install them with: ./dot.sh install ai\n' >&2
  exit 1
fi

if [ "$gui" = 1 ]; then
  for agent in "${started[@]}"; do
    show_in_app "$agent"
  done
  if [ "$inside_herdr" = 1 ]; then
    printf 'Added panes to this Herdr window: %s\n' "${started[*]}"
  else
    printf 'Opened Herdr app. Panes: %s\n' "${started[*]}"
  fi
  exit 0
fi

hc ls

if [ -t 0 ] && [ -t 1 ]; then
  # ctrl+\ detaches. The Herdr app attaches to the same core.
  exec hc attach "${started[0]}"
fi

printf 'Attach with: hc attach <%s>\n' "$(IFS='|'; echo "${started[*]}")"
