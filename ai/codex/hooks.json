{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent-gate --client codex",
            "statusMessage": "Checking permission gate...",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/alexcs/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agent-gate --client codex --event stop",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}