#!/usr/bin/env bash
# share — put a file where the tailnet can download it, and print the link.
# usage: share PATH [PATH...]   |   share --list   |   share --clean
# The drop root is ~/share, served by file-drop.service on 127.0.0.1:58100 and
# published by `tailscale serve`; set SHARE_BASE_URL to its files URL.
# Files are SYMLINKED, not copied: the link always serves the current content.
set -euo pipefail
DROP="$HOME/share"
BASE="${SHARE_BASE_URL:-}"
mkdir -p "$DROP"

case "${1:-}" in
  -l|--list)
    [ -n "$(ls -A "$DROP")" ] && ls -l --time-style=+%F\ %H:%M "$DROP" | tail -n +2 || echo "(empty)"
    exit 0 ;;
  -c|--clean)
    find "$DROP" -maxdepth 1 -type l -! -exec test -e {} \; -print -delete
    exit 0 ;;
  ""| -h|--help)
    sed -n '2,6p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

: "${BASE:?Set SHARE_BASE_URL to the public files URL}"

for src in "$@"; do
  if [ ! -f "$src" ]; then echo "share: not a file: $src" >&2; exit 1; fi
  abs=$(realpath "$src")
  name=$(basename "$abs")
  ln -sfn "$abs" "$DROP/$name"
  # URL-encode so spaces and accents survive the copy/paste into a phone
  enc=$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$name")
  printf '%s\n%s/%s\n' "$abs" "$BASE" "$enc"
done
