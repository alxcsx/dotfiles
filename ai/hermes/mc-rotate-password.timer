[Unit]
Description=Rotate the Minecraft join password every week

[Timer]
# Weekly, Monday 06:00 local (America/Recife) — before the week's classes.
# Change this line to change the cadence; the script and its name are
# cadence-neutral on purpose.
OnCalendar=Mon *-*-* 06:00:00
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
