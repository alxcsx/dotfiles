#!/usr/bin/env python3
"""mc-password — print the current Minecraft shared join password.

PasswordWhitelist stores it base64(UTF-16) in its data file; this decodes it so
the value can be read without parsing ANSI-coloured RCON output.
"""
from __future__ import annotations

import base64
import sys
from pathlib import Path

STORE = Path("/home/alex/services/minecraft/data/plugins/PasswordWhitelist/data/password.properties")

try:
    text = STORE.read_text(encoding="utf-8")
except FileNotFoundError:
    sys.exit("mc-password: no password store — is PasswordWhitelist installed?")

for line in text.splitlines():
    if line.startswith("password="):
        raw = line.split("=", 1)[1].strip()
        if not raw:
            sys.exit("mc-password: no password set (run mc-rotate-password)")
        print(base64.b64decode(raw).decode("utf-16"))
        break
else:
    sys.exit("mc-password: no password entry in the store")
