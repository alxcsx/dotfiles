+def _known_skill_names() -> Optional[set[str]]:
+    """Every skill name resolvable from this process, or None when unknown.
+
+    A bad name is not harmless: the worker rejects it at SPAWN, which burns one
+    claim, retries twice, trips the breaker, and parks the card for a human who
+    has no CLI verb to repair `tasks.skills` (only `edit --skill` added below).
+    Rejecting at creation costs nothing and the caller can still correct it.
+    `KNOWN_TOOLSET_NAMES` catches the toolset/skill confusion; this catches the
+    other half — a CATEGORY (`creative`) or a PROFILE (`architect`), both of which
+    look exactly like skill names and both of which killed a real card.
+
+    Fail-open on any error: card creation must never depend on this probe.
+    """
+    try:
+        from agent.skill_utils import get_all_skills_dirs
+
+        roots = get_all_skills_dirs()
+    except Exception:
+        return None
+    names: set[str] = set()
+    for root in roots:
+        try:
+            names.update(md.parent.name for md in Path(root).rglob("SKILL.md"))
+        except OSError:
+            continue
+    return names or None
+
