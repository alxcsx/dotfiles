[Unit]
Description=Sanitizing egress proxy for remote LLM APIs (127.0.0.1:58020)
Documentation=file:///home/alex/dotfiles/ai-assistant/hermes/egress-proxy.py
After=network-online.target

[Service]
Type=simple
# Machine-local env: EGRESS_UPSTREAM, EGRESS_API_KEY, EGRESS_PORT.
# The '-' keeps the unit startable without the file (proxy then answers 502
# with instructions instead of crashing).
EnvironmentFile=-%h/.config/egress-proxy/env
ExecStart=/usr/bin/python3 %h/dotfiles/ai-assistant/hermes/egress-proxy.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
